{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "jefflouden.com log",
  "description": "The entries on /log, newest first. The kind and date are kept in the markup but not shown. The words are Jeff's own.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "$schema": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "description": "A thing: a film, album, song, book, site or object, linked by its title.",
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "date", "title", "text"],
            "properties": {
              "kind": { "type": "string", "enum": ["movie", "film", "album", "song", "book", "site", "thing"] },
              "date": { "$ref": "#/$defs/date" },
              "title": { "type": "string" },
              "url": { "type": "string", "pattern": "^https?://" },
              "text": { "type": "string" },
              "image": { "$ref": "#/$defs/image" },
              "place": { "$ref": "#/$defs/place" }
            }
          },
          {
            "description": "A quote, with who said it underneath.",
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "date", "quote", "who"],
            "properties": {
              "kind": { "const": "quote" },
              "date": { "$ref": "#/$defs/date" },
              "quote": { "description": "Without the quotation marks. The page adds them.", "type": "string" },
              "who": { "type": "string" },
              "text": { "type": "string" },
              "place": { "$ref": "#/$defs/place" }
            }
          },
          {
            "description": "A note: one line of text, with no title.",
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "date", "text"],
            "properties": {
              "kind": { "const": "note" },
              "date": { "$ref": "#/$defs/date" },
              "text": { "type": "string" },
              "image": { "$ref": "#/$defs/image" },
              "place": { "$ref": "#/$defs/place" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "image": {
      "description": "A photo in public/images/log/, prepared by scripts/log_photo.py: a JPEG at most 1600px on its long side, with no metadata (so no location). The build reads its size.",
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt"],
      "properties": {
        "src": { "type": "string", "pattern": "^images/log/[a-z0-9][a-z0-9-]*\\.jpg$" },
        "alt": { "description": "What the photo shows, for anyone who can't see it.", "type": "string", "minLength": 1 }
      }
    },
    "place": { "description": "Where, as Jeff wants it said (a city or a neighborhood, never an address). Shown quietly under the entry.", "type": "string", "minLength": 1 }
  }
}
