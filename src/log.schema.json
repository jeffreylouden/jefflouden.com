{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "jefflouden.com log",
  "description": "The entries on /log, newest first. The kind and date are kept in the markup but not shown. The words are Jeff's own.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "$schema": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "description": "A thing: a film, album, song, book, site or object, linked by its title.",
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "date", "title", "text"],
            "properties": {
              "kind": { "type": "string", "enum": ["movie", "film", "album", "song", "book", "site", "thing"] },
              "date": { "$ref": "#/$defs/date" },
              "title": { "type": "string" },
              "url": { "type": "string", "pattern": "^https?://" },
              "text": { "type": "string" }
            }
          },
          {
            "description": "A quote, with who said it underneath.",
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "date", "quote", "who"],
            "properties": {
              "kind": { "const": "quote" },
              "date": { "$ref": "#/$defs/date" },
              "quote": { "description": "Without the quotation marks. The page adds them.", "type": "string" },
              "who": { "type": "string" },
              "text": { "type": "string" }
            }
          },
          {
            "description": "A note: one line of text, with no title.",
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "date", "text"],
            "properties": {
              "kind": { "const": "note" },
              "date": { "$ref": "#/$defs/date" },
              "text": { "type": "string" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
