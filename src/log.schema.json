{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "jefflouden.com log",
  "description": "The entries in public/log.md, newest first: things Jeff likes, work he has done, quotes and notes, for agents. The words are Jeff's own.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "$schema": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "description": "A thing he likes (a film, album, song, book, site or object) or a piece of his work (something he shipped, wrote, spoke about or learned), named by its title.",
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "date", "title", "text"],
            "properties": {
              "kind": { "type": "string", "enum": ["movie", "album", "song", "book", "site", "thing", "shipped", "wrote", "spoke", "learned"] },
              "date": { "$ref": "#/$defs/date" },
              "title": { "type": "string", "minLength": 1 },
              "url": { "$ref": "#/$defs/url" },
              "text": { "type": "string", "minLength": 1 },
              "place": { "$ref": "#/$defs/place" }
            }
          },
          {
            "description": "Something he photographed, told in words. The picture itself is not published.",
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "date", "shows"],
            "properties": {
              "kind": { "const": "photo" },
              "date": { "$ref": "#/$defs/date" },
              "shows": { "description": "What the photo shows.", "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "url": { "$ref": "#/$defs/url" },
              "text": { "type": "string", "minLength": 1 },
              "place": { "$ref": "#/$defs/place" }
            }
          },
          {
            "description": "A quote, with who said it.",
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "date", "quote", "who"],
            "properties": {
              "kind": { "const": "quote" },
              "date": { "$ref": "#/$defs/date" },
              "quote": { "description": "Without the quotation marks. The build adds them.", "type": "string", "minLength": 1 },
              "who": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "place": { "$ref": "#/$defs/place" }
            }
          },
          {
            "description": "A note: his words, with no title.",
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "date", "text"],
            "properties": {
              "kind": { "const": "note" },
              "date": { "$ref": "#/$defs/date" },
              "text": { "type": "string", "minLength": 1 },
              "place": { "$ref": "#/$defs/place" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "date": { "description": "The day it was logged.", "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "url": { "type": "string", "pattern": "^https?://\\S+$" },
    "place": { "description": "Where, as Jeff wants it said: a city or a neighborhood, never an address.", "type": "string", "minLength": 1 }
  }
}
