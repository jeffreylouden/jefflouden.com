# Built by build.py from src/templates/_headers and src/site.json.
# The home page gets these from functions/_middleware.js instead, with a
# per-response CSP nonce in place of the hashes, which build.py computes
# from every inline script on the static pages.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-Y8M2nyVjJnbpSzcmLPBDqtbo3uvzaY9uq6XXH+BQgis=' 'sha256-TEg9mkwG25g5ME2hxSxosbLh2Tn4Wz9ri0mCG9+p1pY=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.png
  Cache-Control: public, max-age=604800

/*.jpg
  Cache-Control: public, max-age=604800

/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/log.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/index.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/index.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/.well-known/ai-catalog.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *

# Web Key Directory (direct method): the OpenPGP key for jeff@, so
# `gpg --locate-keys jeff@jefflouden.com` finds it. The spec asks for CORS.
/.well-known/openpgpkey/*
  Content-Type: application/octet-stream
  Access-Control-Allow-Origin: *

/jeffrey-louden.vcf
  Content-Type: text/vcard; charset=utf-8
  Content-Disposition: attachment; filename="jeffrey-louden.vcf"

# A short URL, but a descriptive name when someone saves it.
/resume.pdf
  Content-Disposition: inline; filename="jeffrey-louden-resume.pdf"
